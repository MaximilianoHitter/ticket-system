{
  "name": "ticket-system",
  "private": true,
  "author": {
    "name": "Maximiliano Hitter",
    "email": "maximilianohitter@gmail.com"
  },
  "scripts": {
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "build": "pnpm -r build",
    "prepare": "husky"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "eslint": "^9.15.0"
    }
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.4.2"
  },
  "lint-staged": {
    "apps/backend/**/*.{ts,js}": [
      "pnpm --filter backend exec eslint --fix",
      "pnpm --filter backend exec prettier --write"
    ],
    "apps/frontend/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter frontend exec eslint --fix",
      "pnpm --filter frontend exec prettier --write"
    ],
    "**/*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
