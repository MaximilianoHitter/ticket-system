// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleModel {
  ADMIN
  GESTOR
  CLIENTE
}

model UserModel {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      RoleModel     @default(CLIENTE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  projectMemberships ProjectMemberModel[]
  createdProjects    ProjectModel[]       @relation("ProjectCreator")

  @@index([email])
  @@index([role])
  @@map("users")
}

model ProjectModel {
  id          String    @id @default(uuid())
  name        String
  description String?
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  creator UserModel            @relation("ProjectCreator", fields: [createdBy], references: [id])
  members ProjectMemberModel[]

  @@index([createdBy])
  @@map("projects")
}

model ProjectMemberModel {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  createdAt DateTime @default(now())

  project ProjectModel @relation(fields: [projectId], references: [id])
  user    UserModel    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}
